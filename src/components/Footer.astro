---
const redesSociales = [
  { nombre: "Instagram", enlace: "https://instagram.com/" },
  { nombre: "Facebook", enlace: "https://facebook.com/" },
  { nombre: "TikTok", enlace: "https://tiktok.com/" }
];

const anioActual = new Date().getFullYear();
---

{/* Pie de página de Tejiendo Sueños */}

<footer class="footer" id="contacto">
  <div class="footer-contenido">
    <div class="marca">
      <h2>🧶 Tejiendo Sueños</h2>
      <p>Cada puntada cuenta una historia ♡</p>
      <span>Creaciones hechas a mano con amor.</span>
    </div>

    <div class="redes">
      <h3>Síguenos</h3>

      <div class="enlaces-redes">
        {redesSociales.map((red) => (
          <a href={red.enlace} target="_blank" rel="noopener noreferrer">
                    {red.nombre === "Instagram" && "📸"}
                    {red.nombre === "Facebook" && "💜"}
                    {red.nombre === "TikTok" && "🎵"}
                    {red.nombre}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="copyright">
    <p>© {anioActual} Tejiendo Sueños. Todos los derechos reservados.</p>
  </div>
</footer>

